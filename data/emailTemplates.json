{
  "reminder": {
    "subject": "Reminder: {{alertName}} - Due on {{dueDate}}",
    "body": "<div style=\"font-family:Arial,Helvetica,sans-serif; max-width:520px; margin:0 auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; overflow:hidden;\"><div style=\"background:#132A46; padding:20px 28px;\"><span style=\"font-size:16px; font-weight:700; letter-spacing:0.5px; color:#ffffff;\">NORREN<span style=\"color:#EF4136;\">ALERTS</span></span></div><div style=\"padding:28px; font-size:15px; line-height:1.6; color:#1f2937;\"><p style=\"margin:0 0 16px;\">Dear {{owner}},</p><p style=\"margin:0 0 16px;\">This is a reminder that the following alert is approaching its due date and requires your attention.</p><table role=\"presentation\" width=\"100%\" style=\"background:#f9fafb; border-radius:6px; margin:0 0 16px; border-collapse:collapse;\"><tr><td style=\"padding:10px 14px; font-weight:600; width:120px;\">Alert</td><td style=\"padding:10px 14px;\">{{alertName}}</td></tr><tr><td style=\"padding:10px 14px; font-weight:600;\">Due Date</td><td style=\"padding:10px 14px;\">{{dueDate}}</td></tr><tr><td style=\"padding:10px 14px; font-weight:600;\">Subsidiary</td><td style=\"padding:10px 14px;\">{{subsidiary}}</td></tr><tr><td style=\"padding:10px 14px; font-weight:600; vertical-align:top;\">Description</td><td style=\"padding:10px 14px;\">{{description}}</td></tr></table><p style=\"margin:0 0 24px;\">Kindly review the above alert and ensure that the required action is completed by the stated due date.</p><a href=\"{{loginUrl}}\" style=\"display:inline-block; background:#EF4136; color:#ffffff; text-decoration:none; font-weight:600; font-size:14px; padding:12px 24px; border-radius:6px;\">Open NorrenAlerts &rarr;</a></div><div style=\"background:#f9fafb; padding:16px 28px; border-top:1px solid #e5e7eb;\"><p style=\"margin:0; font-size:12px; color:#9ca3af;\">NorrenAlerts &middot; Powered by Norrenberger Robotics Process Automation Unit</p></div></div>"
  },
  "escalation": {
    "subject": "Escalation: {{alertName}} - Action Overdue",
