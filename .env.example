# Storage backend: "json" (local files) or "sql" (PostgreSQL)
STORAGE_PROVIDER=json

# --- PostgreSQL (only needed when STORAGE_PROVIDER=sql) ---

# Option A: connection string (preferred on managed providers)
# DATABASE_URL=postgresql://user:password@host:5432/alert_system

# Option B: individual settings
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=alert_system
# PG_USER=alert_app
# PG_PASSWORD=change-me

# SSL: set PG_SSL=true to force on, PG_SSL=false to force off.
# When unset, SSL is enabled automatically if DATABASE_URL is set.
# PG_SSL=false
# PG_SSL_REJECT_UNAUTHORIZED=true
# PG_POOL_MAX=10

# App
# PORT=3000
# Required when NODE_ENV=production. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=replace-with-a-long-random-string
# NODE_ENV=production

# Behind a reverse proxy / HTTPS (Azure App Service, Render, nginx...): trust it and mark the cookie secure.
# TRUST_PROXY=1
# COOKIE_SECURE=true

# With several copies of the app, the reminder scheduler runs on one of them at a time automatically.
# To keep it off a particular copy (for example web-only copies): SCHEDULER_ENABLED=false
